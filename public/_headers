# Cloudflare response headers (copied to dist/ by Vite). See README.md > Hosting.

# Vite names every file in /assets/ after a hash of its contents, so a changed file gets a new name
# and browsers can keep these for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Vercel sent this on every response; keep it so browsers stay on HTTPS.
/*
  Strict-Transport-Security: max-age=63072000
